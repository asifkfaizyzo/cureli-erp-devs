// ============================================
// PRISMA CONFIGURATION
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

// --- Admin ---
enum CAdminRole {
  SUPER_ADMIN
  ANALYST
  ACCOUNTING
}

// --- Plans ---
enum PlanStatus {
  DRAFT
  ACTIVE
  DEPRECATED
  SUSPENDED
}

enum PlanType {
  PRE_MADE
  CUSTOM
}

// --- Tickets ---
enum TicketCategory {
  TECHNICAL_ISSUE
  BILLING_ISSUE
  FEATURE_REQUEST
  ACCOUNT_ISSUE
  OTHER
}

enum TicketStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CANCELLED
  CLOSED
}

// --- Enquiries ---
enum EnquiryStatus {
  PENDING
  IN_PROGRESS
  REPLIED
  CLOSED
}

// --- Inventory ---
enum StockMovementType {
  PURCHASE
  PURCHASE_RETURN
  SALE
  SALE_RETURN
  OPENING_STOCK
  STOCK_ADJUSTMENT
  DAMAGED
  EXPIRED
  TRANSFER_IN
  TRANSFER_OUT
}

enum AdjustmentReason {
  PHYSICAL_COUNT_VARIANCE
  DAMAGED_GOODS
  EXPIRED_GOODS
  SYSTEM_CORRECTION
  THEFT_LOSS
  OTHER
}

//----- purchase return ---
enum ReturnReason {
  DAMAGED_GOODS
  EXPIRED_GOODS
  WRONG_ITEM_RECEIVED
  QUALITY_ISSUE
  EXCESS_STOCK
  PRICE_DIFFERENCE
  OTHER
}

enum PaymentAdjustmentType {
  CASH_REFUND
  CREDIT_NOTE
  OFFSET_NEXT_PURCHASE
}

enum ReturnApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED 
}


// ============================================
// AUDIT LOG (APPEND-ONLY, COMPLIANCE-GRADE)
// ============================================

model AuditLog {
  audit_id       String   @id @default(uuid()) @db.Uuid

  // What happened
  action         String   @db.VarChar(100)

  // Who caused it
  actor_type     String   @db.VarChar(20)
  actor_id       String?  @db.Uuid
  actor_role     String?  @db.VarChar(50)

  // What was affected
  entity_type    String   @db.VarChar(30)
  entity_id      String?  @db.Uuid

  // Scope context
  shop_id        String?  @db.Uuid
  branch_id      String?  @db.Uuid

  // Grouping related events
  correlation_id String?  @db.Uuid

  // Why (optional)
  reason_code    String?  @db.VarChar(50)

  // Payload
  metadata       Json?    @db.JsonB

  // Request context
  ip_address     String?  @db.Text
  user_agent     String?  @db.Text

  // When
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  // Indexes
  @@index([shop_id, created_at(sort: Desc)])
  @@index([entity_type, entity_id, created_at(sort: Desc)])
  @@index([actor_id, created_at(sort: Desc)])
  @@index([action, created_at(sort: Desc)])
  @@index([correlation_id])
  @@index([created_at(sort: Desc)])

  @@map("audit_logs")
}

// ============================================
// CURELI ADMIN
// ============================================

model CAdmin {
  cadmin_id           String     @id @default(uuid()) @db.Uuid
  name                String     @db.Text
  username            String     @unique @db.Text
  email               String?    @unique @db.Text
  phone_number        String     @db.Text
  password_hash       String     @db.Text
  role                CAdminRole @default(SUPER_ADMIN)
  is_active           Boolean    @default(true)

  verification_id     String?   @db.Text
  otp_expires         DateTime?
  reset_token         String?   @db.VarChar(500)
  reset_token_expires DateTime? @db.Timestamptz(6)

  last_login_at       DateTime?
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @updatedAt @db.Timestamptz(6)

  // Relations
  broadcastCampaigns  BroadcastCampaign[]  @relation("BroadcastCampaigns")
  broadcastSegments   BroadcastSegment[]   @relation("BroadcastSegments")
  broadcastTemplates  BroadcastTemplate[]  @relation("BroadcastTemplates")
  createdPlans        Plan[]               @relation("PlanCreator")
  planActivities      PlanActivityLog[]    @relation("PlanActivityByCAdmin")
  activityLogs        CAdminActivityLog[]  @relation("CAdminActivityLogs")
  enquiryReplies      EnquiryReply[]       @relation("EnquiryRepliedBy")
  notifications       Notification[]       @relation("CAdminNotifications")  // ✅ ADD THIS

  @@map("cadmins")
}

model CAdminActivityLog {
  id              String   @id @default(uuid()) @db.Uuid
  cadmin_id       String   @db.Uuid
  performed_by_id String?  @db.Uuid
  action          String   @db.VarChar(50)
  description     String?  @db.Text
  changes         Json?
  meta            Json?
  ip_address      String?  @db.Text
  user_agent      String?  @db.Text
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  cadmin CAdmin @relation("CAdminActivityLogs", fields: [cadmin_id], references: [cadmin_id], onDelete: Cascade)

  @@index([cadmin_id])
  @@index([action])
  @@index([created_at])
  @@map("cadmin_activity_logs")
}

// ============================================
// USERS
// ============================================

model PendingUser {
  pending_id     String  @id @default(uuid()) @db.Uuid
  first_name     String
  last_name      String
  email          String  @unique
  password_hash  String?
  google_id      String? @unique
  login_provider String  @default("password")
  username       String?

  email_otp_hash    String?
  email_otp_expires DateTime?
  email_verified    Boolean   @default(false)

  phone               String?   @db.Text
  sms_verification_id String?   @db.Text
  sms_transaction_id  String?   @db.Text
  sms_otp_expires     DateTime? @db.Timestamptz
  sms_verified        Boolean   @default(false)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@map("pending_users")
}

model User {
  user_id        String  @id @default(uuid()) @db.Uuid
  shop_id        String? @db.Uuid
  branch_id      String? @db.Uuid
  first_name     String
  last_name      String
  full_name      String
  username       String? @unique
  email          String? @unique
  phone_number   String?
  password_hash  String?
  google_id      String? @unique
  login_provider String
  role           String
  status         String  @default("pending_setup")
  is_active      Boolean @default(true)
  onboarding_step Int    @default(4)

  first_login_after_verification Boolean   @default(false)
  first_verified_at              DateTime? @db.Timestamptz(6)

  reset_token         String?   @db.VarChar(500)
  reset_token_expires DateTime? @db.Timestamptz(6)

  phone_change_new_number      String?   @db.Text
  phone_change_verification_id String?   @db.Text
  phone_change_old_verified    Boolean   @default(false)
  phone_change_expires         DateTime? @db.Timestamptz(6)

  email_change_new_email       String?   @db.Text
  email_change_verification_id String?   @db.Text
  email_change_otp_hash        String?   @db.Text
  email_change_expires         DateTime? @db.Timestamptz(6)

  login_verification_id String?   @db.Text
  login_otp_expires     DateTime? @db.Timestamptz(6)
  login_otp_attempts    Int       @default(0)

  last_login_at DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @updatedAt @db.Timestamptz(6)

  // Relations
  shops_owned                   Shop[]                @relation("OwnerOfShop")
  branch                        Branch?               @relation(fields: [branch_id], references: [branch_id])
  shop                          Shop?                 @relation("UsersInShop", fields: [shop_id], references: [shop_id])
  shopFiles                     ShopFile[]
  activityLogs                  ActivityLog[]
  sessions                      UserSession[]
  ticketsCreated                Ticket[]              @relation("TicketCreator")
  ticketsCancelled              Ticket[]              @relation("TicketCanceller")
  ticketsReopened               Ticket[]              @relation("TicketReopener")
  notifications                 Notification[]        @relation("UserNotifications")
  medicinesCreated              Medicine[]            @relation("MedicineCreator")
  suppliersCreated              Supplier[]            @relation("SupplierCreator")
  purchaseInvoicesCreated       PurchaseInvoice[]     @relation("PurchaseInvoiceCreator")
  purchaseInvoicesConfirmed     PurchaseInvoice[]     @relation("PurchaseInvoiceConfirmer")
  purchasePayments              PurchasePayment[]     @relation("PaymentCreator")
  stockLedgerEntries            StockLedger[]         @relation("StockLedgerCreator")
  adjustmentsCreated            StockAdjustment[]     @relation("AdjustmentCreator")
  adjustmentsApproved           StockAdjustment[]     @relation("AdjustmentApprover")
  returnsApproved    PurchaseInvoice[]     @relation("ReturnApprover")
  returnsRejected    PurchaseInvoice[]     @relation("ReturnRejecter")
  creditApplications CreditApplication[]   @relation("CreditApplicationsBy")

  @@map("users")
}

model UserSession {
  id             String    @id @default(uuid()) @db.Uuid
  user_id        String    @db.Uuid
  session_token  String    @unique @db.Text
  device_info    String?   @db.Text
  ip_address     String?   @db.Text
  is_active      Boolean   @default(true)

  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  last_active_at DateTime  @default(now()) @db.Timestamptz(6)
  expires_at     DateTime  @db.Timestamptz(6)
  ended_at       DateTime? @db.Timestamptz(6)
  ended_reason   String?   @db.Text

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
  @@index([session_token])
  @@index([is_active])
  @@index([expires_at])
  @@map("user_sessions")
}

// ============================================
// SHOPS & BRANCHES
// ============================================

model Shop {
  shop_id                 String  @id @default(uuid()) @db.Uuid
  owner_user_id           String  @db.Uuid
  business_name           String
  legal_name              String?
  gst_number              String? @unique
  business_type           String?
  address_line_1          String
  address_line_2          String?
  city                    String
  state                   String
  pincode                 String
  verification_status     String  @default("pending")
  verification_notes      String?
  current_subscription_id String? @unique @db.Uuid
  is_active               Boolean @default(true)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  branches            Branch[]
  owner               User                 @relation("OwnerOfShop", fields: [owner_user_id], references: [user_id])
  users               User[]               @relation("UsersInShop")
  shopFiles           ShopFile[]
  paymentTransactions PaymentTransaction[] @relation("ShopPayments")
  subscriptions       ShopSubscription[]   @relation("ShopSubscriptions")
  customPlans         Plan[]               @relation("CustomPlanShop")
  currentSubscription ShopSubscription?    @relation("CurrentSubscription", fields: [current_subscription_id], references: [subscription_id])
  tickets             Ticket[]             @relation("ShopTickets")
  medicines           Medicine[]           @relation("ShopMedicines")
  suppliers           Supplier[]           @relation("ShopSuppliers")
  purchaseInvoices    PurchaseInvoice[]    @relation("ShopPurchaseInvoices")
  purchasePayments    PurchasePayment[]    @relation("ShopPurchasePayments")
  inventory           Inventory[]          @relation("ShopInventory")
  stockLedger         StockLedger[]        @relation("ShopStockLedger")
  stockAdjustments    StockAdjustment[]    @relation("ShopStockAdjustments")
  supplierCredits SupplierCredit[] @relation("ShopSupplierCredits")

  @@map("shops")
}

model Branch {
  branch_id        String  @id @default(uuid()) @db.Uuid
  shop_id          String  @db.Uuid
  branch_name      String
  branch_type      String  @default("main")
  address_line_1   String?
  address_line_2   String?
  city             String?
  state            String?
  pincode          String?
  contact_number   String?
  alternate_number String?
  is_active        Boolean @default(true)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  shop             Shop                @relation(fields: [shop_id], references: [shop_id])
  users            User[]
  tickets          Ticket[]            @relation("BranchTickets")
  purchaseInvoices PurchaseInvoice[]   @relation("BranchPurchaseInvoices")
  medicines        Medicine[]          @relation("BranchMedicines")
  inventory        Inventory[]         @relation("BranchInventory")
  stockLedger      StockLedger[]       @relation("BranchStockLedger")
  stockAdjustments StockAdjustment[]   @relation("BranchStockAdjustments")

  @@map("branches")
}

model ShopFile {
  file_id            String    @id @default(uuid()) @db.Uuid
  shop_id            String    @db.Uuid
  file_type          String    @db.Text
  storage_key        String    @db.Text
  original_name      String    @db.Text
  mime_type          String    @db.Text
  file_size          Int
  status             String    @default("uploaded") @db.Text
  verification_notes String?   @db.Text
  resubmission_count Int       @default(0)
  uploaded_by        String    @db.Uuid

  uploaded_at         DateTime  @default(now()) @db.Timestamptz(6)
  verified_at         DateTime? @db.Timestamptz(6)
  rejected_at         DateTime? @db.Timestamptz(6)
  last_resubmitted_at DateTime? @db.Timestamptz(6)

  shop Shop @relation(fields: [shop_id], references: [shop_id])
  user User @relation(fields: [uploaded_by], references: [user_id])

  @@map("shop_files")
}

// ============================================
// SUBSCRIPTIONS & PLANS
// ============================================

model ShopSubscription {
  subscription_id String @id @default(uuid()) @db.Uuid
  shop_id         String @db.Uuid
  plan_id         String @db.Uuid

  status         String
  billing_cycle  String @default("yearly")
  payment_status String

  start_date         DateTime  @db.Timestamptz(6)
  end_date           DateTime  @db.Timestamptz(6)
  renewal_date       DateTime  @db.Timestamptz(6)
  grace_period_until DateTime? @db.Timestamptz(6)

  branch_limit_snapshot Int
  user_limit_snapshot   Int

  is_active Boolean @default(true)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  plan                Plan                 @relation(fields: [plan_id], references: [plan_id])
  shop                Shop                 @relation("ShopSubscriptions", fields: [shop_id], references: [shop_id])
  paymentTransactions PaymentTransaction[] @relation("SubscriptionPayments")
  currentForShop      Shop?                @relation("CurrentSubscription")

  @@index([plan_id])
  @@index([shop_id])
  @@index([is_active])
  @@index([end_date])
  @@map("shop_subscriptions")
}

model Plan {
  plan_id     String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  type        PlanType @default(PRE_MADE)

  price            BigInt
  compare_at_price BigInt?

  max_branches Int
  max_users    Int

  billing_cycle_months Int @default(12)
  bonus_months         Int @default(0)

  promo_free_until DateTime? @db.Timestamptz(6)

  is_customizable Boolean @default(false)
  is_featured     Boolean @default(false)

  created_for_shop_id String? @db.Uuid

  status     PlanStatus @default(ACTIVE)
  created_by String?    @db.Uuid

  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @updatedAt @db.Timestamptz(6)
  activated_at DateTime? @db.Timestamptz(6)
  suspended_at DateTime? @db.Timestamptz(6)
  deleted_at   DateTime? @db.Timestamptz(6)

  subscriptions  ShopSubscription[]
  creator        CAdmin?            @relation("PlanCreator", fields: [created_by], references: [cadmin_id])
  createdForShop Shop?              @relation("CustomPlanShop", fields: [created_for_shop_id], references: [shop_id])
  activityLogs   PlanActivityLog[]

  @@index([status])
  @@index([type])
  @@index([deleted_at])
  @@index([created_for_shop_id])
  @@map("plans")
}

model PlanActivityLog {
  id          String  @id @default(uuid()) @db.Uuid
  plan_id     String  @db.Uuid
  cadmin_id   String? @db.Uuid
  action      String  @db.VarChar(50)
  from_status String? @db.VarChar(20)
  to_status   String? @db.VarChar(20)
  changes     Json?
  meta        Json?

  created_at DateTime @default(now()) @db.Timestamptz(6)

  plan   Plan    @relation(fields: [plan_id], references: [plan_id])
  cadmin CAdmin? @relation("PlanActivityByCAdmin", fields: [cadmin_id], references: [cadmin_id])

  @@index([plan_id])
  @@index([cadmin_id])
  @@index([action])
  @@index([created_at])
  @@map("plan_activity_logs")
}

// ============================================
// PAYMENTS
// ============================================

model PaymentTransaction {
  transaction_id      String  @id @default(uuid()) @db.Uuid
  shop_id             String  @db.Uuid
  subscription_id     String? @db.Uuid
  provider            String
  provider_order_id   String? @unique
  provider_payment_id String? @unique
  amount              BigInt
  currency            String  @default("INR")
  status              String
  meta                Json?

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  shop         Shop              @relation("ShopPayments", fields: [shop_id], references: [shop_id])
  subscription ShopSubscription? @relation("SubscriptionPayments", fields: [subscription_id], references: [subscription_id])

  @@map("payment_transactions")
}

// ============================================
// ACTIVITY LOGS (LEGACY — RETAINED)
// ============================================

model ActivityLog {
  activity_id String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  action      String   @db.Text
  description String?  @db.Text
  ip_address  String?  @db.Text
  user_agent  String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
  @@map("activity_logs")
}

model DeletionLog {
  id              String   @id @default(uuid()) @db.Uuid
  user_id         String   @db.Uuid
  email           String?
  username        String?
  reason          String
  onboarding_step Int?
  days_inactive   Int?
  files_deleted   Int      @default(0)
  deleted_at      DateTime @default(now()) @db.Timestamptz(6)

  @@map("deletion_logs")
}

model FileVerificationLog {
  id         String   @id @default(uuid()) @db.Uuid
  file_id    String   @db.Uuid
  shop_id    String   @db.Uuid
  cadmin_id  String?  @db.Uuid
  actor_type String   @db.Text
  action     String   @db.Text
  reason     String?  @db.Text
  meta       Json?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([file_id])
  @@map("file_verification_logs")
}

// ============================================
// TICKETS
// ============================================

model Ticket {
  ticket_id           String         @id @default(uuid()) @db.Uuid
  ticket_number       String         @unique @db.VarChar(30)
  shop_id             String         @db.Uuid
  branch_id           String?        @db.Uuid
  created_by_user_id  String         @db.Uuid
  contact_number      String         @db.VarChar(15)
  category            TicketCategory
  subject             String         @db.VarChar(200)
  description         String?        @db.Text
  other_category_text String?        @db.VarChar(100)
  preferred_slot      String         @db.VarChar(20)
  status              TicketStatus   @default(PENDING)
  admin_notes         String?        @db.Text

  cancelled_at        DateTime? @db.Timestamptz(6)
  cancelled_by_id     String?   @db.Uuid
  cancellation_reason String?   @db.Text

  reopened_at    DateTime? @db.Timestamptz(6)
  reopened_by_id String?   @db.Uuid
  reopen_count   Int       @default(0)
  reopen_reason  String?   @db.Text

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  shop          Shop                  @relation("ShopTickets", fields: [shop_id], references: [shop_id])
  branch        Branch?               @relation("BranchTickets", fields: [branch_id], references: [branch_id])
  created_by    User                  @relation("TicketCreator", fields: [created_by_user_id], references: [user_id])
  cancelled_by  User?                 @relation("TicketCanceller", fields: [cancelled_by_id], references: [user_id])
  reopened_by   User?                 @relation("TicketReopener", fields: [reopened_by_id], references: [user_id])
  attachments   TicketAttachment[]
  statusHistory TicketStatusHistory[] @relation("TicketStatusHistory")

  @@index([shop_id])
  @@index([branch_id])
  @@index([status])
  @@index([created_at])
  @@index([created_by_user_id])
  @@index([ticket_number])
  @@map("tickets")
}

model TicketAttachment {
  attachment_id String   @id @default(uuid()) @db.Uuid
  ticket_id     String   @db.Uuid
  storage_key   String   @db.Text
  original_name String   @db.VarChar(255)
  mime_type     String   @db.VarChar(100)
  file_size     Int
  uploaded_at   DateTime @default(now()) @db.Timestamptz(6)

  ticket Ticket @relation(fields: [ticket_id], references: [ticket_id], onDelete: Cascade)

  @@index([ticket_id])
  @@map("ticket_attachments")
}

model TicketStatusHistory {
  id              String        @id @default(uuid()) @db.Uuid
  ticket_id       String        @db.Uuid
  changed_by_type String        @db.VarChar(20)
  changed_by_id   String        @db.Uuid
  changed_by_name String        @db.VarChar(100)
  from_status     TicketStatus?
  to_status       TicketStatus
  note            String?       @db.Text
  created_at      DateTime      @default(now()) @db.Timestamptz(6)

  ticket Ticket @relation("TicketStatusHistory", fields: [ticket_id], references: [ticket_id], onDelete: Cascade)

  @@index([ticket_id])
  @@index([created_at])
  @@map("ticket_status_history")
}

// ============================================
// ENQUIRIES
// ============================================

model Enquiry {
  enquiry_id     String        @id @default(uuid()) @db.Uuid
  enquiry_number String        @unique @db.VarChar(30)
  name           String        @db.VarChar(100)
  email          String        @db.VarChar(255)
  phone          String?       @db.VarChar(20)
  message        String        @db.Text
  status         EnquiryStatus @default(PENDING)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  replies EnquiryReply[]

  @@index([status])
  @@index([created_at])
  @@index([email])
  @@map("enquiries")
}

model EnquiryReply {
  reply_id      String    @id @default(uuid()) @db.Uuid
  enquiry_id    String    @db.Uuid
  replied_by_id String    @db.Uuid
  subject       String    @db.VarChar(200)
  message       String    @db.Text
  email_sent    Boolean   @default(false)
  email_sent_at DateTime? @db.Timestamptz(6)
  email_error   String?   @db.Text
  created_at    DateTime  @default(now()) @db.Timestamptz(6)

  enquiry    Enquiry @relation(fields: [enquiry_id], references: [enquiry_id], onDelete: Cascade)
  replied_by CAdmin  @relation("EnquiryRepliedBy", fields: [replied_by_id], references: [cadmin_id])

  @@index([enquiry_id])
  @@index([replied_by_id])
  @@map("enquiry_replies")
}

// ============================================
// PHARMACY: MEDICINES & SUPPLIERS
// ============================================

model Medicine {
  medicine_id     String  @id @default(uuid()) @db.Uuid

  // Basic Information
  name            String  @db.VarChar(200)
  generic_name    String? @db.VarChar(200)

  // Manufacturer & Classification
  manufacturer    String  @db.VarChar(150)
  category        String? @db.VarChar(100)
  sub_category    String? @db.VarChar(100)

  // Regulatory
  schedule        String? @db.VarChar(50)
  hsn_code        String? @db.VarChar(20)

  // Packaging
  pack_size       String? @db.VarChar(50)
  unit_of_measure String  @default("UNIT")

  // Pricing & Tax
  gst_percentage  Decimal @default(12) @db.Decimal(5, 2)
  cgst_percentage Decimal @default(6) @db.Decimal(5, 2)
  sgst_percentage Decimal @default(6) @db.Decimal(5, 2)

  // Storage
  rack_no         String? @db.VarChar(20)

  // Stock Level Thresholds (Product-level defaults)
  min_stock_level Decimal? @db.Decimal(10, 2)
  max_stock_level Decimal? @db.Decimal(10, 2)
  reorder_point   Decimal? @db.Decimal(10, 2)

  // Status
  is_active       Boolean @default(true)
  is_discontinued Boolean @default(false)

  // Metadata
  shop_id    String   @db.Uuid
  branch_id  String?  @db.Uuid
  created_by String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  shop             Shop                  @relation("ShopMedicines", fields: [shop_id], references: [shop_id], onDelete: Cascade)
  branch           Branch?               @relation("BranchMedicines", fields: [branch_id], references: [branch_id])
  creator          User                  @relation("MedicineCreator", fields: [created_by], references: [user_id])
  purchaseItems    PurchaseInvoiceItem[] @relation("PurchaseLineItems")
  inventory        Inventory[]           @relation("MedicineInventory")
  stockLedger      StockLedger[]         @relation("MedicineStockLedger")
  stockAdjustments StockAdjustment[]     @relation("MedicineStockAdjustments")

  // Indexes
  @@unique([shop_id, branch_id, name, manufacturer])
  @@index([shop_id, branch_id, is_active])
  @@index([shop_id, is_active])
  @@index([shop_id, name])
  @@index([hsn_code])
  @@index([manufacturer])
  @@map("medicines")
}

model Supplier {
