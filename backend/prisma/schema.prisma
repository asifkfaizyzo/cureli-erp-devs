model Inventory {
  inventory_id String @id @default(uuid()) @db.Uuid

  shop_id     String  @db.Uuid
  branch_id   String? @db.Uuid
  medicine_id String  @db.Uuid

  batch_number       String    @db.VarChar(50)
  expiry_date        DateTime  @db.Date
  manufacturing_date DateTime? @db.Date

  current_stock   Decimal  @default(0) @db.Decimal(10, 2)
  reserved_stock  Decimal  @default(0) @db.Decimal(10, 2)
  available_stock Decimal  @default(0) @db.Decimal(10, 2)
  minimum_stock   Decimal? @db.Decimal(10, 2)

  last_purchase_rate Decimal?  @db.Decimal(10, 2)
  last_purchase_date DateTime? @db.Date
  mrp                Decimal   @db.Decimal(10, 2)
  selling_rate       Decimal?  @db.Decimal(10, 2)

  rack_no String? @db.VarChar(20)

  is_active  Boolean @default(true)
  is_expired Boolean @default(false)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  shop           Shop                  @relation("ShopInventory", fields: [shop_id], references: [shop_id], onDelete: Cascade)
  branch         Branch?               @relation("BranchInventory", fields: [branch_id], references: [branch_id])
  medicine       Medicine              @relation("MedicineInventory", fields: [medicine_id], references: [medicine_id])
  stockMovements StockLedger[]         @relation("InventoryStockMovements")
  adjustments    StockAdjustment[]     @relation("InventoryAdjustments")
  purchaseItems  PurchaseInvoiceItem[] @relation("PurchaseItemInventory")

  @@unique([shop_id, medicine_id, batch_number, branch_id])
  @@index([shop_id, medicine_id])
  @@index([batch_number])
  @@index([expiry_date])
  @@index([shop_id, current_stock])
  @@index([is_expired])
  @@map("inventory")
}

model StockLedger {
  ledger_id String @id @default(uuid()) @db.Uuid

  // Relations
  shop_id      String  @db.Uuid
  branch_id    String? @db.Uuid
  medicine_id  String  @db.Uuid
  inventory_id String  @db.Uuid

  // Transaction Details
  movement_type    StockMovementType
  reference_type   String?           @db.VarChar(50)
  reference_id     String?           @db.Uuid
  reference_number String?           @db.VarChar(100)

  // Batch Information
  batch_number String   @db.VarChar(50)
  expiry_date  DateTime @db.Date

  // Quantity Changes
  quantity_in   Decimal @default(0) @db.Decimal(10, 2)
  quantity_out  Decimal @default(0) @db.Decimal(10, 2)
  quantity_net  Decimal @db.Decimal(10, 2)
  balance_after Decimal @db.Decimal(10, 2)

  // Pricing
  rate   Decimal? @db.Decimal(10, 2)
  amount Decimal? @db.Decimal(12, 2)

  // Additional Info
  remarks String? @db.Text

  // Metadata
  transaction_date DateTime @db.Date
  created_by       String   @db.Uuid
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  shop            Shop             @relation("ShopStockLedger", fields: [shop_id], references: [shop_id], onDelete: Cascade)
  branch          Branch?          @relation("BranchStockLedger", fields: [branch_id], references: [branch_id])
  medicine        Medicine         @relation("MedicineStockLedger", fields: [medicine_id], references: [medicine_id])
  inventory       Inventory        @relation("InventoryStockMovements", fields: [inventory_id], references: [inventory_id])
  creator         User             @relation("StockLedgerCreator", fields: [created_by], references: [user_id])
  // ✅ ADD THIS: Optional relation to PurchaseInvoice (only when reference_type is PURCHASE_INVOICE)
  purchaseInvoice PurchaseInvoice? @relation("StockLedgerPurchaseInvoice", fields: [reference_id], references: [invoice_id], onDelete: SetNull)

  // Indexes
  @@index([shop_id, medicine_id, transaction_date])
  @@index([inventory_id, transaction_date])
  @@index([reference_type, reference_id])
  @@index([movement_type])
  @@index([batch_number])
  @@index([transaction_date])
  @@map("stock_ledger")
}

model StockAdjustment {
  adjustment_id String @id @default(uuid()) @db.Uuid

  // Relations
  shop_id      String  @db.Uuid
  branch_id    String? @db.Uuid
  medicine_id  String  @db.Uuid
  inventory_id String  @db.Uuid

  // Batch Information
  batch_number String @db.VarChar(50)

  // Adjustment Details
  reason       AdjustmentReason
  reason_notes String?          @db.Text

  // Quantity Changes
  old_quantity Decimal @db.Decimal(10, 2)
  new_quantity Decimal @db.Decimal(10, 2)
  variance     Decimal @db.Decimal(10, 2)

  // Metadata
  adjustment_date DateTime  @db.Date
  approved_by     String?   @db.Uuid
  approved_at     DateTime? @db.Timestamptz(6)
  created_by      String    @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @updatedAt @db.Timestamptz(6)

  // Relations
  shop      Shop      @relation("ShopStockAdjustments", fields: [shop_id], references: [shop_id], onDelete: Cascade)
  branch    Branch?   @relation("BranchStockAdjustments", fields: [branch_id], references: [branch_id])
  medicine  Medicine  @relation("MedicineStockAdjustments", fields: [medicine_id], references: [medicine_id])
  inventory Inventory @relation("InventoryAdjustments", fields: [inventory_id], references: [inventory_id])
  creator   User      @relation("AdjustmentCreator", fields: [created_by], references: [user_id])
  approver  User?     @relation("AdjustmentApprover", fields: [approved_by], references: [user_id])

  // Indexes
  @@index([shop_id, adjustment_date])
  @@index([medicine_id])
  @@index([inventory_id])
  @@index([reason])
  @@map("stock_adjustments")
}



// ============================================
// IN-APP NOTIFICATIONS
// ============================================

model Notification {
  notification_id String @id @default(uuid()) @db.Uuid

  // Recipient - ONE of these must be set (enforced at app level)
  user_id   String? @db.Uuid
  cadmin_id String? @db.Uuid

  // Event type
  event_type String @db.VarChar(100)

  // Display content
  title   String @db.VarChar(200)
  message String @db.Text

  // Structured data for click-through actions
  context Json? @db.JsonB

  // Scoping (for user notifications)
  shop_id   String? @db.Uuid
  branch_id String? @db.Uuid

  // Deduplication key
  dedup_key String? @db.VarChar(255)

  // Priority
  priority String @default("normal") @db.VarChar(20)

  // Read status
  is_read Boolean   @default(false)
  read_at DateTime? @db.Timestamptz(6)

  // Timestamps
  created_at DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  user   User?   @relation("UserNotifications", fields: [user_id], references: [user_id], onDelete: Cascade)
  cadmin CAdmin? @relation("CAdminNotifications", fields: [cadmin_id], references: [cadmin_id], onDelete: Cascade)

  // Indexes
  @@index([user_id, is_read, created_at(sort: Desc)])
  @@index([user_id, created_at(sort: Desc)])
  @@index([cadmin_id, is_read, created_at(sort: Desc)])
  @@index([cadmin_id, created_at(sort: Desc)])
  @@index([shop_id, event_type])
  @@index([dedup_key])
  @@index([created_at(sort: Desc)])
  @@map("notifications")
}

// ============================================
// ✅ NEW: BROADCAST CAMPAIGNS (IN-APP)
// ============================================

model BroadcastCampaign {
  campaign_id String @id @default(uuid()) @db.Uuid

  // Content
  title    String @db.VarChar(200)
  message  String @db.Text
  priority String @default("normal") @db.VarChar(20)

  // Rich content attachments
  // [{type: 'link'|'image'|'video', url: string, label?: string}]
  attachments Json? @db.JsonB

  // Action button
  action_url   String? @db.VarChar(500)
  action_label String? @db.VarChar(100)

  // Audience (stored as JSON)
  target_filters  Json @db.JsonB
  recipient_count Int?

  // Audience type tracking
  target_users   Boolean @default(true)
  target_cadmins Boolean @default(false)

  // Status & Scheduling
  status        String    @default("draft") @db.VarChar(20)
  scheduled_for DateTime? @db.Timestamptz(6)
  sent_at       DateTime? @db.Timestamptz(6)

  // Delivery stats
  delivered_count Int?
  read_count      Int?

  // Expiry
  expires_at DateTime? @db.Timestamptz(6)

  // Meta
  created_by_cadmin String   @db.Uuid
  cadmin_name       String   @db.VarChar(100)
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  cadmin CAdmin @relation("BroadcastCampaigns", fields: [created_by_cadmin], references: [cadmin_id])

  // Indexes
  @@index([status, scheduled_for])
  @@index([created_by_cadmin])
  @@index([created_at(sort: Desc)])
  @@map("broadcast_campaigns")
}

// ✅ NEW: Saved audience segments
model BroadcastSegment {
  segment_id        String   @id @default(uuid()) @db.Uuid
  name              String   @db.VarChar(100)
  description       String?  @db.Text
  filters           Json     @db.JsonB
  created_by_cadmin String   @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @updatedAt @db.Timestamptz(6)

  cadmin CAdmin @relation("BroadcastSegments", fields: [created_by_cadmin], references: [cadmin_id])

  @@index([created_by_cadmin])
  @@map("broadcast_segments")
}

// ✅ NEW: Message templates
model BroadcastTemplate {
  template_id       String   @id @default(uuid()) @db.Uuid
  name              String   @db.VarChar(100)
  title             String   @db.VarChar(200)
  message           String   @db.Text
  priority          String   @default("normal") @db.VarChar(20)
  attachments       Json?    @db.JsonB
  usage_count       Int      @default(0)
  created_by_cadmin String   @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @updatedAt @db.Timestamptz(6)

  cadmin CAdmin @relation("BroadcastTemplates", fields: [created_by_cadmin], references: [cadmin_id])

  @@index([created_by_cadmin])
  @@index([usage_count(sort: Desc)])
  @@map("broadcast_templates")
}