# .env.production (create this file - NEVER commit to git)
# ==========================
# DATABASE
# ==========================
DATABASE_URL=postgresql://prod_user:prod_password@prod_host:5432/cureli_prod

# ==========================
# CADMIN CREDENTIALS (PRODUCTION)
# ==========================
CADMIN_DEFAULT_USERNAME=cadmin
CADMIN_DEFAULT_PASSWORD=YourSecureProductionPassword123!
CADMIN_DEFAULT_EMAIL=admin@cureli.com
CADMIN_DEFAULT_PHONE=1234567890
CADMIN_DEFAULT_NAME=Super Admin

# ==========================
# JWT SECRETS (CHANGE THESE IN PRODUCTION)
# ==========================
JWT_ACCESS_SECRET=your-strong-random-secret-here
JWT_REFRESH_SECRET=your-strong-random-refresh-secret

# ==========================
# EMAIL OTP 
# ==========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=production@cureli.com
SMTP_PASS=your-production-smtp-password
DAILY_EMAIL_LIMIT=10000
UNSUBSCRIBE_SECRET=your-production-unsubscribe-secret
APP_URL=https://curelihealth.com

# ==========================
# SMS OTP 
# ==========================
MC_CUSTOMER=your-production-customer-id
MC_PASSWORD=your-production-password
MC_COUNTRY=91
SMS_OTP_LENGTH=4

# ==========================
# JWT EXPIRATION TIMES
# ==========================
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d
JWT_TEMP_SECRET=your-production-temp-secret

# C-ADMIN JWT
ADMIN_JWT_ACCESS_SECRET=your-production-admin-access-secret
ADMIN_JWT_REFRESH_SECRET=your-production-admin-refresh-secret
ADMIN_ACCESS_TOKEN_EXPIRES=15m
ADMIN_REFRESH_TOKEN_EXPIRES=7d

# ==========================
# OAUTH
# ==========================
GOOGLE_CLIENT_ID=your-production-google-client-id
RECAPTCHA_SECRET_KEY=your-production-recaptcha-secret
RECAPTCHA_THRESHOLD=0.5


# ── Mobile app keys (test while building/UAT, swap to live when releasing) ────
RAZORPAY_MOBILE_KEY_ID=rzp_test_TDxxxxxxxxxxxxxxxtH
RAZORPAY_MOBILE_KEY_SECRET=irpxxxxxxxxxxxxxxxxmM6
RAZORPAY_MOBILE_CURRENCY=INR
RAZORPAY_MOBILE_WEBHOOK_SECRET=AJMxxxxxxxxxxxxxxxL9w

# ==========================
# RAZORPAY (PRODUCTION)
# ==========================
RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY
RAZORPAY_KEY_SECRET=YOUR_LIVE_SECRET
RAZORPAY_CURRENCY=INR
FRONTEND_URL=https://app.cureli.com

# ==========================
# RAZORPAY MOBILE (TEST)
# ==========================

# ==========================
# SERVER
# ==========================
USER_FRONTEND_ORIGIN=https://app.cureli.com
ADMIN_FRONTEND_ORIGIN=https://admin.cureli.com
PORT=5000
NODE_ENV=production

# ==========================
# MAINTENANCE MODE
# ==========================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=We are currently performing scheduled maintenance. Please check back soon.
MAINTENANCE_ALLOWED_IPS=