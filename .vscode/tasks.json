      "options": {
        "cwd": "${workspaceFolder}/pharmacy-web"
      },
      "isBackground": true,
      "presentation": {
        "panel": "new"
      }
    },
    {
      "label": "Landing",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/landing-web"
      },
      "isBackground": true,
      "presentation": {
        "panel": "new"
