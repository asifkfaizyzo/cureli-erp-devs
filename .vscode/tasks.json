//.vscode\tasks.json
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start-cureli",
      "dependsOn": [
        "Backend",
        "cAdmin",
        "ERP",
        "Landing",
        "Prisma",
        "Backend tree",
        "Landing tree",
        "ERP tree",
        "cAdmin tree",
        "Git"
      ],
      "dependsOrder": "parallel"
    },
    {
      "label": "Backend",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "presentation": {
        "panel": "new"
      }
    },
    {
      "label": "Backend tree",
      "type": "shell",
      "command": "tree /f; powershell",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/backend/src"
      },
      "presentation": {
        "panel": "new"
      }
    },
    {
      "label": "ERP tree",
      "type": "shell",
      "command": "tree /f; powershell",
      "isBackground": true,
