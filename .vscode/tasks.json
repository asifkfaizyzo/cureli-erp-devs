      "command": "tree /f; powershell",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/cadmin-web/src"
      },
      "presentation": {
        "panel": "new"
      }
    },
    {
      "label": "Landing tree",
      "type": "shell",
